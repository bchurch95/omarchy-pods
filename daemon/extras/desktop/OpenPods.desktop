[Desktop Entry]
Type=Application
Name=OpenPods
GenericName=AirPods controller
Comment=AirPods controller for Linux (OpenPods, fork of LibrePods)
# Point at the user-local wrapper so app launchers (walker, rofi,
# whatever) hit the fork build instead of the AUR system binary.
# Wrapper falls back to /usr/bin/librepods if the fork hasn't been
# compiled. Adjust path if your wrapper lives elsewhere.
Exec=%h/.local/bin/librepods
Icon=librepods
Terminal=false
Categories=AudioVideo;Audio;
StartupNotify=true
# Matches QCoreApplication::setApplicationName("openpods") in main.cpp
# so Hyprland/dock window-matching binds to the live app name.
StartupWMClass=openpods
Keywords=airpods;bluetooth;noise;cancellation;
