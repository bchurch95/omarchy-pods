[Unit]
Description=librepods AirPods daemon
# The AAP link needs BlueZ and a session bus, both of which arrive with the graphical session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Qt enables category debug output by default, and the BLE advertisement line fires several times a second.
Environment=QT_LOGGING_RULES=openpods.debug=false
ExecStart=%h/.local/bin/librepods --hide
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
